<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Rentals - RentRead</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="style.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .rental-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .page-header {
            background: white;
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            text-align: center;
        }

        .page-header h1 {
            font-size: 2.5rem;
            color: #667eea;
            margin-bottom: 10px;
        }

        .page-header p {
            color: #64748b;
            font-size: 1.1rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            transition: all 0.3s;
            border: 2px solid transparent;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.12);
            border-color: #667eea;
        }

        .stat-card .icon {
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .stat-card .number {
            font-size: 2rem;
            font-weight: 700;
            color: #667eea;
            margin-bottom: 5px;
        }

        .stat-card .label {
            color: #64748b;
            font-size: 0.95rem;
            font-weight: 500;
        }

        .rental-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 25px;
        }

        .rental-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            transition: all 0.3s;
            border: 2px solid transparent;
        }

        .rental-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.15);
            border-color: #667eea;
        }

        .book-image-wrapper {
            position: relative;
            height: 250px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            overflow: hidden;
        }

        .book-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .status-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            padding: 8px 16px;
            border-radius: 25px;
            font-size: 0.85rem;
            font-weight: 600;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .status-active {
            background: rgba(16, 185, 129, 0.95);
            color: white;
        }

        .status-expired {
            background: rgba(239, 68, 68, 0.95);
            color: white;
        }

        .rental-info {
            padding: 25px;
        }

        .book-category {
            display: inline-block;
            background: #f1f5f9;
            color: #667eea;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .book-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 8px;
            line-height: 1.4;
        }

        .book-author {
            color: #64748b;
            font-size: 0.95rem;
            margin-bottom: 15px;
        }

        .rental-details {
            background: #f8fafc;
            padding: 15px;
            border-radius: 12px;
            margin: 15px 0;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid #e2e8f0;
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-label {
            color: #64748b;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .detail-value {
            color: #1e293b;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .action-buttons {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .btn {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s;
            text-decoration: none;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        }

        .btn-secondary {
            background: #f1f5f9;
            color: #667eea;
            border: 2px solid #667eea;
        }

        .btn-secondary:hover {
            background: #667eea;
            color: white;
        }

        .empty-state {
            background: white;
            border-radius: 20px;
            padding: 80px 40px;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

        .empty-icon {
            font-size: 5rem;
            margin-bottom: 20px;
        }

        .empty-state h2 {
            font-size: 1.8rem;
            color: #1e293b;
            margin-bottom: 10px;
        }

        .empty-state p {
            color: #64748b;
            font-size: 1.1rem;
            margin-bottom: 30px;
        }

        .loading {
            background: white;
            border-radius: 20px;
            padding: 60px;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

        .spinner {
            border: 5px solid #f1f5f9;
            border-top: 5px solid #667eea;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: white;
            color: #667eea;
            padding: 12px 24px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            margin-bottom: 20px;
            transition: all 0.3s;
        }

        .back-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.12);
            background: #667eea;
            color: white;
        }
    </style>
</head>
        }

        .profile-info {
            display: none; /* Hidden by default */
            gap: 15px;
        }

        .profile-info.show {
            display: grid; /* Show when 'show' class is added */
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--bg-soft);
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            font-weight: 600;
            color: var(--text);
            min-width: 100px;
        }

        .info-value {
            color: var(--muted);
            flex: 1;
            text-align: right;
        }

        /* Profile Edit Modal */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-content {
            background: var(--card);
            border-radius: 12px;
            padding: 30px;
            max-width: 500px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .modal-header h3 {
            margin: 0;
            color: var(--text);
        }

        .close-btn {
            background: none;
            border: none;
            font-size: 1.5em;
            cursor: pointer;
            color: var(--muted);
            padding: 0;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
        }

        .close-btn:hover {
            background: var(--bg-soft);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: var(--text);
        }

        .form-input {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid var(--bg-soft);
            border-radius: 8px;
            background: var(--bg-soft);
            color: var(--text);
            font-size: 14px;
            transition: border-color 0.3s ease;
            box-sizing: border-box;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--accent);
        }

        .form-textarea {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid var(--bg-soft);
            border-radius: 8px;
            background: var(--bg-soft);
            color: var(--text);
            font-size: 14px;
            resize: vertical;
            min-height: 80px;
            font-family: inherit;
            box-sizing: border-box;
        }

        .form-textarea:focus {
            outline: none;
            border-color: var(--accent);
        }

        .form-actions {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 30px;
        }

        .btn-secondary {
            background: var(--bg-soft);
            color: var(--text);
            border: 1px solid var(--bg-soft);
            padding: 10px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-secondary:hover {
            background: var(--muted);
            color: white;
        }
    </style>
</head>
<body>
    <!-- Header / Topbar -->
    <header class="topbar">
        <div class="container row between">
            <a class="brand" href="/">
                <div class="brand-logo">
                    <svg width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                        <!-- Background circle -->
                        <circle cx="20" cy="20" r="18" fill="#4F46E5" stroke="#3730A3" stroke-width="2"/>
                        
                        <!-- Book icon -->
                        <rect x="12" y="14" width="16" height="12" rx="1" fill="#FFFFFF"/>
                        <rect x="12" y="14" width="3" height="12" fill="#E5E7EB"/>
                        <line x1="17" y1="17" x2="26" y2="17" stroke="#9CA3AF" stroke-width="1"/>
                        <line x1="17" y1="19" x2="24" y2="19" stroke="#9CA3AF" stroke-width="1"/>
                        <line x1="17" y1="21" x2="26" y2="21" stroke="#9CA3AF" stroke-width="1"/>
                        <line x1="17" y1="23" x2="25" y2="23" stroke="#9CA3AF" stroke-width="1"/>
                        
                        <!-- Rent arrow -->
                        <circle cx="28" cy="12" r="4" fill="#10B981"/>
                        <path d="M26 12 L28 10 L28 11 L30 11 L30 13 L28 13 L28 14 Z" fill="white"/>
                        
                        <!-- RR text -->
                        <text x="20" y="35" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" font-weight="bold" fill="#4F46E5">RR</text>
                    </svg>
                </div>
                <div>
                    <h1>RentRead</h1>
                    <small>Read more • Spend less</small>
                </div>
            </a>
            <nav class="nav">
                <a href="/">Home</a>
                <a href="/dashboard.html">Dashboard</a>
                <a href="/my_rental.html" class="active">My Rentals</a>
                <a href="/contact.html">Contact</a>
            </nav>
            <div class="actions">
                <div class="theme-selector">
                    <button class="btn" id="toggleTheme" aria-label="Choose theme">🎨 Themes</button>
                    <div class="theme-dropdown" id="themeDropdown">
                        <button class="theme-option" data-theme="light">☀️ Light</button>
                        <button class="theme-option" data-theme="dark">🌙 Dark</button>
                        <button class="theme-option" data-theme="ocean">🌊 Ocean</button>
                        <button class="theme-option" data-theme="forest">🌲 Forest</button>
                        <button class="theme-option" data-theme="sunset">🌅 Sunset</button>
                        <button class="theme-option" data-theme="purple">💜 Purple</button>
                        <button class="theme-option" data-theme="rose">🌹 Rose</button>
                        <button class="theme-option" data-theme="midnight">🌌 Midnight</button>
                        <button class="theme-option" data-theme="galaxy">🌠 Galaxy</button>
                        <button class="theme-option" data-theme="gold">🏆 Gold</button>
                        <button class="theme-option" data-theme="cyber">⚡ Cyber</button>
                        <button class="theme-option" data-theme="cherry">🍒 Cherry</button>
                        <button class="theme-option" data-theme="sky">☁️ Sky</button>
                        <button class="theme-option" data-theme="emerald">💎 Emerald</button>
                        <button class="theme-option" data-theme="lavender">🪻 Lavender</button>
                        <button class="theme-option" data-theme="black">⚫ Black</button>
                        <button class="theme-option" data-theme="red">🔴 Red</button>
                        <button class="theme-option" data-theme="pink">🎀 Pink</button>
                    </div>
                </div>
                <div id="authActions">
                    <button class="btn-secondary" id="btnLogout" onclick="logout()">Logout</button>
                </div>
            </div>
        </div>
    </header>

    <!-- Dashboard Hero -->
    <section class="hero" style="padding: 40px 0;">
        <div class="container">
            <div class="hero-card">
                <div>
                    <h2>My Rented Books</h2>
                    <p>All your rented books and their detailed information</p>
                </div>
            </div>
        </div>
    </section>

    <main class="rental-container">
        <a href="dashboard.html" class="back-button">
            ← Back to Dashboard
        </a>

        <div class="page-header">
            <h1>📚 My Rentals</h1>
            <p>Manage and track all your book rentals in one place</p>
        </div>

        <div class="stats-grid" id="rentalStats">
            <div class="stat-card">
                <div class="icon">📖</div>
                <div class="number" id="totalRentals">0</div>
                <div class="label">Total Rentals</div>
            </div>
            <div class="stat-card">
                <div class="icon">✨</div>
                <div class="number" id="activeRentals">0</div>
                <div class="label">Active Rentals</div>
            </div>
            <div class="stat-card">
                <div class="icon">💰</div>
                <div class="number" id="totalSpent">৳0</div>
                <div class="label">Total Spent</div>
            </div>
            <div class="stat-card">
                <div class="icon">⏰</div>
                <div class="number" id="expiringSoon">0</div>
                <div class="label">Expiring Soon</div>
            </div>
        </div>

        <div id="loadingSection" class="loading">
            <div class="spinner"></div>
            <p style="color:#64748b;margin-top:15px;">Loading your rentals...</p>
        </div>

        <div id="rentalGrid" class="rental-grid" style="display: none;">
            <!-- Rental cards will be inserted here -->
        </div>

        <div id="emptyState" class="empty-state" style="display: none;">
            <div class="empty-icon">📚</div>
            <h2>No Rentals Yet</h2>
            <p>Start your reading journey by renting books from our collection!</p>
            <a href="dashboard.html" class="btn btn-primary">Browse Books →</a>
        </div>
    </main>

    <script>
        let userRentals = [];

        // Check authentication
        function checkAuth() {
            const token = localStorage.getItem('token');
            if (!token) {
                window.location.href = 'login.html';
                return false;
            }
            return true;
        }

        // Load user rentals
        async function loadRentals() {
            try {
                const token = localStorage.getItem('token');
                const response = await fetch('/api/rent/my-rentals', {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (response.ok) {
                    userRentals = await response.json();
                    updateStats();
                    displayRentals();
                } else {
                    throw new Error('Failed to load rentals');
                }
            } catch (error) {
                console.error('Error loading rentals:', error);
                showError('Failed to load rental information');
            } finally {
                document.getElementById('loadingSection').style.display = 'none';
            }
        }

        // Update statistics
        function updateStats() {
            const totalRentals = userRentals.length;
            const activeRentals = userRentals.filter(r => r.status === 'active' && new Date(r.expiry_date) > new Date()).length;
            const totalSpent = userRentals.reduce((sum, r) => sum + parseFloat(r.total_price || 0), 0);
            
            // Calculate expiring soon (within 3 days)
            const threeDaysFromNow = new Date();
            threeDaysFromNow.setDate(threeDaysFromNow.getDate() + 3);
            const expiringSoon = userRentals.filter(r => {
                const expiryDate = new Date(r.expiry_date);
                const now = new Date();
                return r.status === 'active' && expiryDate > now && expiryDate <= threeDaysFromNow;
            }).length;

            document.getElementById('totalRentals').textContent = totalRentals;
            document.getElementById('activeRentals').textContent = activeRentals;
            document.getElementById('totalSpent').textContent = `৳${totalSpent.toFixed(2)}`;
            document.getElementById('expiringSoon').textContent = expiringSoon;
        }

        // Display rentals
        function displayRentals() {
            const rentalGrid = document.getElementById('rentalGrid');
            const emptyState = document.getElementById('emptyState');

            if (userRentals.length === 0) {
                emptyState.style.display = 'block';
                return;
            }

            rentalGrid.style.display = 'grid';
            rentalGrid.innerHTML = '';

            // Sort by rental date (newest first)
            userRentals.sort((a, b) => new Date(b.rental_date) - new Date(a.rental_date));

            userRentals.forEach(rental => {
                const rentalCard = createRentalCard(rental);
                rentalGrid.appendChild(rentalCard);
            });
        }

        // Create rental card
        function createRentalCard(rental) {
            const card = document.createElement('div');
            card.className = 'rental-card';

            const now = new Date();
            const expiryDate = new Date(rental.expiry_date);
            const isActive = rental.status === 'active' && expiryDate > now;
            const isExpired = expiryDate <= now;
            
            let statusClass = 'status-completed';
            let statusText = 'Completed';
            
            if (isActive) {
                statusClass = 'status-active';
                statusText = 'Active';
            } else if (isExpired) {
                statusClass = 'status-expired';
                statusText = 'Expired';
            }

            const daysRemaining = Math.ceil((expiryDate - now) / (1000 * 60 * 60 * 24));

            card.innerHTML = `
                <div class="book-image-wrapper">
                    ${rental.image_url ? 
                        `<img src="${rental.image_url}" alt="${rental.title}" onerror="this.style.display='none'">` : 
                        `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f3f4f6;color:#9ca3af;font-size:48px;">📖</div>`
                    }
                    <div class="status-badge ${statusClass}">${statusText}</div>
                </div>
                
                <div class="book-info">
                    <h3 class="book-title">${rental.title}</h3>
                    <div class="book-meta">
                        <span>✍️ ${rental.author || 'Unknown'}</span>
                        <span>📚 ${rental.category || 'General'}</span>
                    </div>
                    
                    <div class="rental-details">
                        <div class="detail-row">
                            <span class="detail-label">Rental Date:</span>
                            <span class="detail-value">${new Date(rental.rental_date).toLocaleDateString('en-GB')}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Expiry Date:</span>
                            <span class="detail-value">${expiryDate.toLocaleDateString('en-GB')}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Rental Period:</span>
                            <span class="detail-value">${rental.rental_days} days</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Total Cost:</span>
                            <span class="detail-value">৳${rental.total_price}</span>
                        </div>
                        ${isActive && daysRemaining >= 0 ? `
                            <div class="detail-row">
                                <span class="detail-label">Days Remaining:</span>
                                <span class="detail-value" style="font-weight:600;color:${daysRemaining > 3 ? '#10b981' : '#ef4444'};">
                                    ${daysRemaining > 0 ? `${daysRemaining} days` : 'Expires today'}
                                </span>
                            </div>
                        ` : ''}
                    </div>

                    <div class="book-actions">
                        ${isActive && rental.drive_link ? 
                            `<a href="${rental.drive_link}" target="_blank" class="btn btn-primary">
                                📖 Open Book
                            </a>` : 
                            `<button class="btn btn-secondary" disabled>
                                🔒 Not Available
                            </button>`
                        }
                    </div>
                </div>
            `;

            return card;
        }

        // Show rental details
        function showRentalDetails(rentalId) {
            const rental = userRentals.find(r => r.id === rentalId);
            if (!rental) return;

            alert(`Book Details:
            
Title: ${rental.title}
Author: ${rental.author || 'Unknown'}
Category: ${rental.category || 'General'}
Language: ${rental.language || 'English'}
Pages: ${rental.total_pages || 'Unknown'}
Description: ${rental.description || 'No description available'}

Rental Information:
Rental Date: ${new Date(rental.rental_date).toLocaleDateString('en-US')}
Expiry Date: ${new Date(rental.expiry_date).toLocaleDateString('en-US')}
Rental Period: ${rental.rental_days} days
Total Cost: $${rental.total_price}
Access Count: ${rental.access_count || 0} times`);
        }

        // Show error message
        function showError(message) {
            const errorDiv = document.createElement('div');
            errorDiv.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: #f8d7da;
                color: #721c24;
                padding: 15px;
                border-radius: 5px;
                border: 1px solid #f5c6cb;
                z-index: 1000;
            `;
            errorDiv.textContent = message;
            document.body.appendChild(errorDiv);
            
            setTimeout(() => errorDiv.remove(), 5000);
        }

        // Show success message
        function showSuccess(message) {
            const successDiv = document.createElement('div');
            successDiv.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: #d4edda;
                color: #155724;
                padding: 15px;
                border-radius: 5px;
                border: 1px solid #c3e6cb;
                z-index: 1000;
            `;
            successDiv.textContent = message;
            document.body.appendChild(successDiv);
            
            setTimeout(() => successDiv.remove(), 5000);
        }

        // Logout function
        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            window.location.href = 'index.html';
        }

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            if (!checkAuth()) return;
            
            loadRentals();
        });
    </script>
</body>
</html>