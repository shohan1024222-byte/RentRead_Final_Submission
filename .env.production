# Heroku Environment Variables
PORT=4000
NODE_ENV=production
JWT_SECRET=your-super-secure-jwt-secret-key-here
DB_HOST=your-database-host
DB_USER=your-database-username
DB_PASSWORD=your-database-password
DB_NAME=rentread
BOOKS_DIR=storage/books

# For ClearDB MySQL (Heroku Add-on)
# CLEARDB_DATABASE_URL=mysql://username:password@hostname/database_name

# For JawsDB MySQL (Heroku Add-on)
# JAWSDB_URL=mysql://username:password@hostname:port/database_name